# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Docker / production (PostgreSQL):
DATABASE_URL=postgres://ayumitra:ayumitra@localhost:5432/ayumitra
# Quick local run without PostgreSQL installed:
# DATABASE_URL=sqlite:///db.sqlite3

POSTGRES_DB=ayumitra
POSTGRES_USER=ayumitra
POSTGRES_PASSWORD=ayumitra

# --- Background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- AI service (Phase 6+) ---
AI_SERVICE_URL=http://localhost:8001
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_QUANTIZATION=nf4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PERSIST_DIR=./data/chroma
