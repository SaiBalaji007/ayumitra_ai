# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (SQLite) ---
# No database server needed. Django creates the file on `python manage.py migrate`.
# Default location: backend/db.sqlite3. Set SQLITE_PATH to store it elsewhere (Docker uses /data/db).
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# --- Background jobs ---
REDIS_URL=redis://localhost:6379/0

# --- Documents ---
DOCUMENT_MAX_UPLOAD_MB=20
# True: uploaded reports/prescriptions are read by the AI service.
# Queue "db" = no Redis needed; run `python manage.py process_documents` as the worker.
# Queue "celery" = needs Redis and a Celery worker (Docker setup).
DOCUMENT_PROCESSING_ENABLED=True
DOCUMENT_QUEUE_BACKEND=db
UPLOAD_THROTTLE_RATE=60/hour
AUTH_THROTTLE_RATE=30/min

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- AI service (Phase 6+) ---
AI_SERVICE_URL=http://localhost:8001
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_QUANTIZATION=nf4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PERSIST_DIR=./data/chroma
# Optional locally. If set, start the AI service with the same value in AYUMITRA_SERVICE_TOKEN,
# otherwise it rejects the backend's requests. Leave empty for local development.
AI_SERVICE_TOKEN=
